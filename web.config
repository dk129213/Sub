<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for Plesk Windows hosting.

  Deliberately minimal. Shared hosting locks most system.webServer sections at
  the server level, and IIS answers a locked or unknown section with a blanket
  500 on every request - static files included. Only two things are needed here,
  and both are normally delegated to the site:

    staticContent - teach IIS the AVIF and WebP MIME types, which it does not
                    know by default and would otherwise 404

  No defaultDocument section: Plesk already lists index.html as a default
  document, and re-adding it is a duplicate collection key, which makes IIS
  500 on "/" (and only on "/").

  If this file ever causes a 500 again, rename it to web.config.bak: the site
  will come back immediately, minus AVIF images.
-->
<configuration>
  <system.webServer>


    <staticContent>
      <!-- remove first so this cannot collide with a server-level definition -->
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

  </system.webServer>
</configuration>
